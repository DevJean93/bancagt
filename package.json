{
  "name": "bancagt",
  "private": true,
  "description": "BancaGT en Línea - monorepo (npm workspaces)",
  "type": "module",
  "workspaces": [
    "packages/plataforma",
    "packages/db-core",
    "packages/db-identidad",
    "apps/api-identidad",
    "apps/api-cuentas",
    "apps/api-transferencias",
    "apps/db-migraciones",
    "apps/web-banca"
  ],
  "scripts": {
    "build": "npm run generar -w @bancagt/db-core -w @bancagt/db-identidad && tsc -b && npm run build -w @bancagt/web-banca",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev:web": "npm run dev -w @bancagt/web-banca"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
