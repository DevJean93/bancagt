{
  "name": "@bancagt/plataforma",
  "version": "1.0.0",
  "private": true,
  "description": "Núcleo compartido de los microservicios: servidor HTTP seguro, errores, autenticación, métricas y trazas",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracing": {
      "source": "./src/tracing.ts",
      "types": "./dist/tracing.d.ts",
      "default": "./dist/tracing.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/sdk-node": "0.301.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.18",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  }
}
